---
import { getImage } from 'astro:assets';
import photo from '../assets/sajib.jpg';
import Experience from '../components/Experience.astro';
import Hero from '../components/Hero.astro';
import HowIWork from '../components/HowIWork.astro';
import Projects from '../components/Projects.astro';
import Results from '../components/Results.astro';
import Testimonial from '../components/Testimonial.astro';
import WritingAndTools from '../components/WritingAndTools.astro';
import { SITE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';

const portrait = await getImage({ src: photo, width: 600, height: 720 });

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': new URL('/#person', Astro.site).href,
  name: SITE.name,
  jobTitle: SITE.jobTitle,
  description: SITE.description,
  url: new URL('/', Astro.site).href,
  image: new URL(portrait.src, Astro.site).href,
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.locality,
    addressCountry: SITE.countryCode,
  },
  sameAs: [SITE.linkedIn, SITE.medium],
  knowsAbout: SITE.knowsAbout,
};
---

<BaseLayout
  home
  title={`${SITE.name} · ${SITE.jobTitle}`}
  description={SITE.description}
  jsonLd={person}
>
  <Hero />
  <Results />
  <HowIWork />
  <Testimonial />
  <Experience />
  <Projects />
  <WritingAndTools />
</BaseLayout>
