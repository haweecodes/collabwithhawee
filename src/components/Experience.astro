---
import { experience } from '../data/experience';
import RichText from './RichText.astro';
---

<section id="experience" class="section experience">
  <h2>Where I've made a difference</h2>
  {experience.map((role) => (
    <article class="role">
      <div class="summary">
        <h3>{role.company}</h3>
        <p class="title">{role.title}</p>
        <p class="when">
          {role.period} · {role.location}
        </p>
      </div>
      <ul class="highlights">
        {role.highlights.map((highlight) => (
          <li>
            <RichText text={highlight} />
          </li>
        ))}
      </ul>
    </article>
  ))}
</section>

<style>
  .experience {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  h2 {
    margin-bottom: 24px;
  }

  .role {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 48px;
    padding: 28px 0;
    border-top: 1px solid var(--color-border);
  }

  .role:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .summary {
    display: flex;
    flex: 0 1 260px;
    flex-direction: column;
    gap: 2px;
  }

  .title {
    font-weight: 600;
  }

  .when {
    font-size: var(--text-small);
    color: var(--color-text-subtle);
  }

  .highlights {
    display: flex;
    flex: 1 1 420px;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    padding-left: 20px;
  }
</style>
