---
import { Image } from 'astro:assets';
import photo from '../assets/sajib.jpg';
import { SITE } from '../consts';
---

<section id="top" class="hero">
  <div class="photo">
    <Image
      src={photo}
      alt="Black-and-white portrait of Sajib Hawee in a light striped shirt"
      width={300}
      height={360}
      densities={[1, 2]}
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="intro">
    <h1>{SITE.headline}</h1>
    <p class="lead">
      I'm Sajib Hawee, a senior full-stack engineer with {SITE.yearsOfExperience}+ years across
      React, TypeScript and Node.js. I build features from the interface to the API, and lead the
      migrations, performance work and testing that let product teams ship faster, currently for a
      US SaaS company. I use Claude and Claude Code as everyday engineering partners.
    </p>
    <div class="actions">
      <a class="btn" href="#experience">
        See the results
      </a>
      <a class="tap-link" href={SITE.linkedIn} rel="me">
        LinkedIn
      </a>
      <a class="tap-link" href={SITE.cvPath}>
        Résumé (PDF)
      </a>
    </div>
    <p class="location">Dhaka, Bangladesh · Working remotely · Open to relocation</p>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px 56px;
    margin-top: 72px;
  }

  .photo {
    flex: 0 1 300px;
    height: 360px;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-tint);
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .intro {
    display: flex;
    flex: 1 1 420px;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }

  .lead {
    font-size: var(--text-lead);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-top: 8px;
  }

  .location {
    font-size: var(--text-small);
    color: var(--color-text-subtle);
  }
</style>
